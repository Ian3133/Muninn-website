      "event_overview": {
        "available": true,
        "title": "About Youth Protests",
        "subject": "Youth Protests",
        "summary": "Youth-led demonstrations in India grew around alleged irregularities in the 2026 National Eligibility-cum-Entrance Test for undergraduate medical education (NEET-UG), including claims of a leaked paper and the disruption caused by a nationwide re-examination. The protests, centered visibly in New Delhi but supported more broadly, expanded into demands for accountability, examination-system reforms, and the education minister’s departure.",
        "facts": [
          {
            "label": "Examination and re-test dates",
            "value": "NTA scheduled NEET-UG 2026 for May 3, 2026; its official notices show that a re-examination was conducted on June 21, 2026.",
            "source_ids": [
              "o1",
              "o2"
            ]
          },
          {
            "label": "Examination purpose",
            "value": "NEET-UG is the common, uniform entrance test for undergraduate medical education in India; it also applies to specified undergraduate Indian-system-of-medicine and homeopathy courses.",
            "source_ids": [
              "o3"
            ]
          },
          {
            "label": "Exam administrator",
            "value": "The National Testing Agency (NTA), an autonomous organization under India’s Ministry of Education’s Department of Higher Education, administers NEET-UG and other national entrance examinations.",
            "source_ids": [
              "o4",
              "o5"
            ]
          },
          {
            "label": "Protest setting and stated demands",
            "value": "The movement’s most visible sit-in site was Jantar Mantar in central New Delhi. Organizers sought the education minister’s resignation, examination reforms, and compensation for families of students reported to have died by suicide after exam irregularities.",
            "source_ids": [
              "o6",
              "o7"
            ]
          },
          {
            "label": "Legal context",
            "value": "India’s Public Examinations (Prevention of Unfair Means) Act, 2024, in force from June 21, 2024, covers paper or answer-key leaks and related collusion among prohibited unfair means in covered public examinations.",
            "source_ids": [
              "o8",
              "o9"
            ]
          }
        ],
